rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // COLEÇÃO: salas
    // Cada documento = uma sala de cotação
    // ============================================
    match /salas/{salaId} {
      // Leitura e criação livres para qualquer usuário autenticado.
      allow read, create: if request.auth != null;

      // Update NÃO é mais livre. Baseado no que o app realmente faz com
      // updateDoc()/transação na sala, só duas coisas podem mudar de cada
      // vez — nunca o documento inteiro:
      //
      //  1) entrarSala() grava só a PRÓPRIA entrada em participantes
      //     (participantes.<meu uid>) — ninguém pode escrever ou apagar
      //     a entrada de outro participante nem trocar de "dono".
      //  2) adicionarProduto()/editarProduto()/removerProduto() só mexem
      //     no array `produtos` — continua liberado pra qualquer
      //     participante, é o catálogo compartilhado da cotação.
      //
      // nome, criadoEm, ativa e criadorUid nunca aparecem nessas duas
      // listas, então ficam automaticamente imutáveis após a criação —
      // é o que fecha o "sequestro de sala" (trocar criadorUid pra depois
      // poder excluir) e a falsificação de participante/mercado.
      allow update: if request.auth != null && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantes'])
          && request.resource.data.participantes.diff(resource.data.participantes).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.participantes[request.auth.uid].uid == request.auth.uid
          && request.resource.data.participantes[request.auth.uid].nome is string
          && request.resource.data.participantes[request.auth.uid].mercado is string
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['produtos'])
          && request.resource.data.produtos is list
        )
      );

      // Quem criou a sala pode excluí-la. Salas antigas (criadas antes do
      // campo criadorUid existir) não têm como saber quem criou — nesse
      // caso, qualquer participante da sala pode excluí-la.
      allow delete: if request.auth != null && (
        ('criadorUid' in resource.data && resource.data.criadorUid == request.auth.uid)
        || (!('criadorUid' in resource.data) && request.auth.uid in resource.data.participantes)
      );

      // ============================================
      // SUBCOLEÇÃO: precos
      // Cada preço é um documento próprio: { produtoId, mercado, preco, ... }
      // Só quem está registrado naquele mercado pode gravar o preço dele.
      // ============================================
      match /precos/{precoId} {
        allow read: if request.auth != null;

        allow create, update: if request.auth != null
          && request.resource.data.produtoId is string
          && request.resource.data.mercado is string
          && request.resource.data.preco is number
          && request.resource.data.preco > 0
          // Marcacao de oferta (convenio/fidelidade/clube): opcional, mas
          // se vier tem que ter o tipo certo pra ninguem gravar lixo.
          && (!('oferta' in request.resource.data) || request.resource.data.oferta is bool)
          && (!('tipoOferta' in request.resource.data) || (request.resource.data.tipoOferta is string && request.resource.data.tipoOferta.size() <= 40))
          && (!('obsOferta' in request.resource.data) || (request.resource.data.obsOferta is string && request.resource.data.obsOferta.size() <= 120))
          && get(/databases/$(database)/documents/salas/$(salaId)).data.participantes[request.auth.uid].mercado
             == request.resource.data.mercado;

        // Só o dono daquele mercado pode apagar o próprio preço, ou quem
        // pode excluir a sala inteira (criador, ou qualquer participante
        // se for uma sala antiga sem criadorUid — usado pela limpeza em massa).
        allow delete: if request.auth != null
          && (
            (
              ('criadorUid' in get(/databases/$(database)/documents/salas/$(salaId)).data)
              ? get(/databases/$(database)/documents/salas/$(salaId)).data.criadorUid == request.auth.uid
              : request.auth.uid in get(/databases/$(database)/documents/salas/$(salaId)).data.participantes
            )
            || get(/databases/$(database)/documents/salas/$(salaId)).data.participantes[request.auth.uid].mercado == resource.data.mercado
          );
      }
    }

    // ============================================
    // COLEÇÃO: produtos
    // Base própria de produtos cadastrados
    // ============================================
    match /produtos/{produtoId} {
      // Qualquer usuário autenticado pode consultar
      allow read: if request.auth != null;

      // Qualquer usuário autenticado pode CRIAR um produto novo
      // Não permite editar ou apagar produtos já cadastrados
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['codigoBarras', 'nome', 'ativo', 'cadastradoEm'])
        && request.resource.data.codigoBarras is string
        && request.resource.data.codigoBarras.size() >= 8
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.ativo == true;

      // Permite CORRIGIR um produto já cadastrado (nome, marca, categoria,
      // quantidade, unidade, ativo/inativo) — usado pela tela de Manutenção.
      // Não deixa trocar o código de barras nem quem cadastrou originalmente.
      // grupoVariante (opcional) liga produtos como "mesmo item, tamanho
      // diferente" — usado pela tela de Manutenção pra vincular/desvincular.
      allow update: if request.auth != null
        && request.resource.data.codigoBarras == resource.data.codigoBarras
        && request.resource.data.cadastradoPor == resource.data.cadastradoPor
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.ativo is bool
        && (
          !('grupoVariante' in request.resource.data)
          || request.resource.data.grupoVariante == null
          || (request.resource.data.grupoVariante is string && request.resource.data.grupoVariante.size() <= 60)
        );

      // Não permite apagar — usa o campo "ativo" pra desativar sem perder histórico
      allow delete: if false;
    }

  }
}
